# Weekly Report Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to GitHub

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Google Analytics 4
GA4_PROPERTY_ID=properties/your_ga4_property_id
GA4_CREDENTIALS_FILE=/path/to/ga4-credentials.json

# Firebase
FIREBASE_CREDENTIALS_FILE=/path/to/firebase-credentials.json

# Email (Gmail SMTP)
REPORT_EMAIL_SENDER=your_gmail@gmail.com
REPORT_EMAIL_PASSWORD=your_gmail_app_password
